# ========================================
# VARIÁVEIS DE AMBIENTE - NEXT.JS + SUPABASE
# ========================================
#
# IMPORTANTE: Copie este arquivo e renomeie para .env.local
# Configure estas mesmas variáveis na sua plataforma de hospedagem
#

# Variáveis do Supabase (OBRIGATÓRIAS)
# Estas variáveis são expostas no frontend (prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="sua_url_do_supabase_aqui"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_anon_key_do_supabase_aqui"

# Chave Service Role do Supabase (OBRIGATÓRIA)
# Esta variável é SECRETA e só funciona no backend
# NUNCA exponha no frontend ou em repositórios públicos
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"

# ========================================
# COMO CONFIGURAR NA PLATAFORMA DE HOSPEDAGEM
# ========================================
#
# Se você está usando Vercel, Netlify ou outra plataforma:
#
# 1. Vá nas configurações do projeto
# 2. Procure por "Environment Variables" ou "Variáveis de Ambiente"
# 3. Adicione as 3 variáveis acima com os valores corretos
# 4. Faça um novo deploy após adicionar as variáveis
#
# ========================================
